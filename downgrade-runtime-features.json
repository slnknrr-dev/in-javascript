    "groupby": "object/object-groupby-polyfil",
    "object-descriptors": "object/object-descriptors-polyfil",
    "object-fromentries": "object/object-fromentries-polyfil",
    "object-hasown": "object/object-hasown-polyfil",
    "object-values-entries": "object/object-values-entries-polyfil",
    "promise-allsettled": "promise/promise-allsettled-polyfil",
    "promise-any": "promise/promise-any-polyfil",
    "promise-finally": "promise/promise-finally-polyfil",
    "promise-try": "promise/promise-try-polyfil",
    "promise-withresolvers": "promise/promise-withresolvers-polyfil",
    "regexp-escape": "regexp/regexp-escape-polyfil",
